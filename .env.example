# Excalidraw self-hosted — environment template.
# Copy to .env (next to the compose file), then:
#   docker compose up -d --build        # local build mode (compose.yaml)
#   docker compose -f compose.ghcr.yaml up -d   # GHCR image mode

# --- GHCR images (compose.ghcr.yaml only) ---
# Prefix of the prebuilt images published by the GHCR workflow:
# ghcr.io/<owner>/<repo>/{app,room,storage} — use the same <owner>/<repo> as
# your GitHub repository (forks publish under their own namespace).
GHCR_IMAGE_PREFIX=ghcr.io/your-github-account/excalidraw
# Image tag: latest | vX.Y.Z | sha-<12hex>
#   latest  = newest build on the default branch (or latest version tag)
#   vX.Y.Z  = semver release tag
#   sha-<12hex> = immutable per-push build; pin for reproducible deploys
#                 and rollbacks (the image stays on GHCR forever)
IMAGE_TAG=latest

# --- Host port ---
# Public port mapping for the app (nginx frontend)
APP_PORT=8080

# --- Runtime config (empty = same-origin, single-domain zero config) ---
# Socket.IO server URL; empty = same origin (/socket.io)
WS_SERVER_URL=
# Storage API root (without /api/v2); empty = same origin
STORAGE_BASE_URL=
# Share-link scene backend; empty = same origin /api/v2
BACKEND_V2_GET_URL=
BACKEND_V2_POST_URL=
# Library (assets) URLs; empty = hidden entry
LIBRARY_URL=
LIBRARY_BACKEND=
# Excalidraw+ links; empty = hidden entry
PLUS_LP=
PLUS_APP=
# AI backend; empty = hidden entry
AI_BACKEND=

# Image upload limit in bytes — single source of truth: frontend check +
# storage MAX_BODY_BYTES + nginx client_max_body_size (default 20 MiB)
MAX_FILE_UPLOAD_BYTES=20971520

# room service CORS (default *; same-origin deployments don't need to change)
CORS_ORIGIN=*
